{
	"name": "stroy-control-mini-crm",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b --pretty false",
		"preview": "vite preview --host 0.0.0.0",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"docs/**/*.md\" \"vite.config.ts\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,md,html}\" \"docs/**/*.md\" \"vite.config.ts\""
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.57.0",
		"lucide-react": "^0.468.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^6.2.1",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.5"
	}
}
